        env.DB.prepare("UPDATE client_history SET contract_id = NULL WHERE contract_id = ?").bind(id),
        env.DB.prepare("DELETE FROM contracts WHERE id = ?").bind(id)
      ]);
      return json({ ok: true });
    }
